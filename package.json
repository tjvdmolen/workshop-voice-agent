{
  "name": "voice-agent-workshop",
  "version": "1.0.0",
  "description": "Low-latency voice AI agent on Cloudflare Workers AI (Flux STT, Llama, Aura TTS, smart-turn-v2)",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --name voice-agent-$USER",
    "tail": "wrangler tail voice-agent-$USER",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.98.0"
  }
}
